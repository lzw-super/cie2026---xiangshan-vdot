diff --git a/src/isa/riscv64/instr/rvv/vcompute.h b/src/isa/riscv64/instr/rvv/vcompute.h
index 2bcb6aae..8b66f059 100644
--- a/src/isa/riscv64/instr/rvv/vcompute.h
+++ b/src/isa/riscv64/instr/rvv/vcompute.h
@@ -19,6 +19,28 @@
 #include "vcompute_impl.h"
 #include "vcommon.h"
 
+// Stage3 model: exact signed int8 dot over bytes 0..7, not an RVV reduction.
+def_EHelper(vdot) {
+  require_vector(true);
+  if (vtype->vsew != 0 || vtype->vlmul != 0 || vl->val != 8 ||
+      vstart->val != 0 || !s->vm) {
+    longjmp_exception(EX_II);
+  }
+  // Read all source elements before writing: vd may alias either source or v0.
+  int32_t sum = 0;
+  for (int i = 0; i < 8; ++i) {
+    uint32_t a = cpu.vr[id_src1->reg]._8[i];
+    uint32_t b = cpu.vr[id_src2->reg]._8[i];
+    int32_t sa = a < 128 ? (int32_t)a : (int32_t)a - 256;
+    int32_t sb = b < 128 ? (int32_t)b : (int32_t)b - 256;
+    sum += sa * sb;
+  }
+  memset(&cpu.vr[id_dest->reg], 0, sizeof(cpu.vr[id_dest->reg]));
+  cpu.vr[id_dest->reg]._32[0] = (uint32_t)sum;
+  vstart->val = 0;
+  vp_set_dirty();
+}
+
 def_EHelper(vadd) {
   ARITH(ADD, SIGNED)
 }
